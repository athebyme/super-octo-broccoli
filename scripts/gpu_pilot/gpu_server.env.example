# Подключение к арендованному GPU-серверу пилота «Фотостудии».
# Скопируйте в КОРЕНЬ репозитория как .env.gpu (он в .gitignore) и заполните.
# Реальные значения НЕ коммитить — ни сюда, ни в README, ни в логи.

# --- SSH к машине ---
GPU_SERVER_HOST=            # публичный IP сервера (см. панель immers.cloud)
GPU_SERVER_USER=ubuntu
GPU_SSH_KEY=~/.ssh/immers_b.pem   # приватный ключ (chmod 600)

# --- OpenStack CLI immers.cloud (управление сервером: старт/стоп/статус) ---
OS_AUTH_URL=https://api.immers.cloud:5000/v3
OS_IDENTITY_API_VERSION=3
OS_PROJECT_DOMAIN_NAME=Default
OS_USER_DOMAIN_NAME=Default
OS_PROJECT_NAME=            # имя проекта
OS_USERNAME=                # логин
OS_PASSWORD=                # пароль (после пилота смените!)
