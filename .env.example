# ============================================
# Seller Platform Configuration
# ============================================

# Домен (Caddy автоматически получит Let's Encrypt сертификат)
# Пример: DOMAIN=seller.my-domain.ru
DOMAIN=

# Порты
SELLER_PORT=5001
CALCULATOR_PORT=5000

# Безопасность (ОБЯЗАТЕЛЬНО СМЕНИТЕ В ПРОДАКШЕНЕ!)
# Сгенерируйте надёжный ключ командой: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
APP_SECRET_KEY=

# База данных - ВАЖНО: путь должен указывать на volume
DATABASE_URL=sqlite:////app/data/seller_platform.db

# Process-shared advisory locks (single container / multiple Gunicorn workers)
SCHEDULER_LOCK_FILE=/tmp/seller-platform-scheduler.lock
BRAND_SYNC_LOCK_FILE=/tmp/seller-platform-brand-sync.lock

# Шифрование API ключей (оставьте пустым для генерации)
ENCRYPTION_KEY=

# Marketplace rollout. Ozon account UI and live connection checks are dark by default.
MARKETPLACE_OZON_ENABLED=0
MARKETPLACE_OZON_PUBLICATION_ENABLED=0
MARKETPLACE_OZON_COMMERCIAL_WRITES_ENABLED=0

# Администратор по умолчанию (ОБЯЗАТЕЛЬНО СМЕНИТЕ ПАРОЛЬ!)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Публичный URL сервера (для раздачи фото в WB)
# Должен совпадать с DOMAIN. WB скачивает фото по этим URL
# Пример: PUBLIC_BASE_URL=https://seller.my-domain.ru
PUBLIC_BASE_URL=

# Фотостудия: server-side image providers (ключи не попадают в браузер)
GEN_API_KEY=
AITUNNEL_API_KEY=

# HTTPS endpoint scripts/gpu_pilot/http_bridge.py на GPU-сервере.
# Для локального SSH/WireGuard tunnel с http://127.0.0.1 разрешите HTTP отдельно.
GPU_IMAGE_SERVER_URL=
GPU_IMAGE_SERVER_TOKEN=
GPU_IMAGE_ALLOW_HTTP=0
GPU_IMAGE_STEPS=4
GPU_IMAGE_TRUE_CFG=1.0
GPU_IMAGE_RUB_PER_GENERATION=1.0

# Safety/budget limits seller-scoped лаборатории
IMAGE_LAB_MAX_ACTIVE_JOBS=3
IMAGE_LAB_DAILY_JOB_LIMIT=50
IMAGE_LAB_DAILY_BUDGET_RUB=500
IMAGE_LAB_PROVIDER_TIMEOUT=180
IMAGE_LAB_DATA_DIR=data/image_lab
IMAGE_LAB_INLINE_WORKER=1
INFOGRAPHIC_REMBG_MODEL=u2net

# Только на GPU bridge; значение должно совпадать с GPU_IMAGE_SERVER_TOKEN.
GPU_BRIDGE_TOKEN=

# HTTPS / SSL
# Оставьте пустыми чтобы авто-генерировать self-signed сертификат
SSL_CERT_PATH=
SSL_KEY_PATH=
# CN для self-signed сертификата (по умолчанию: seller-platform)
SSL_COMMON_NAME=
# Дополнительные IP и домены для сертификата (через запятую)
# Пример: SSL_SAN_IPS=123.45.67.89,my-domain.ru
SSL_SAN_IPS=
